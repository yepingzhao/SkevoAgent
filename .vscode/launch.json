{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bear Code: Interactive REPL",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Bear Code: One-shot Prompt",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "args": [
        "${input:bearCodePrompt}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Bear Code: Plan Mode",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.main",
      "args": [
        "--plan",
        "${input:bearCodePlanPrompt}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "-v",
        "${relativeFile}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: All",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "bearCodePrompt",
      "type": "promptString",
      "description": "Prompt to run once",
      "default": "Summarize this project"
    },
    {
      "id": "bearCodePlanPrompt",
      "type": "promptString",
      "description": "Prompt to analyze in Plan Mode",
      "default": "Analyze how to improve this project"
    }
  ]
}
